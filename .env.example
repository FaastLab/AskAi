# =============================================================================
# AskAi configuration — copy to .env and fill in.
# All values have sensible defaults for local docker-compose dev.
# =============================================================================

# -------- Application --------
APP_ENV=dev                       # dev | staging | prod
APP_LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
APP_LOG_FORMAT=pretty             # pretty (dev) | json (prod)

# -------- Postgres (vectors + metadata + sessions) --------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=askai
POSTGRES_PASSWORD=askai
POSTGRES_DB=askai
DATABASE_URL=postgresql+asyncpg://askai:askai@localhost:5432/askai

# -------- Redis (Celery broker + cache) --------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# -------- MinIO / S3-compatible storage --------
STORAGE_PROVIDER=minio            # minio | s3 | azure-blob
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=askai
MINIO_REGION=us-east-1

# -------- LLM provider --------
# LLM_MODEL is the high-quality answer model (Ask AI + validator).
# SUMMARISATION_MODEL is the cheaper/higher-rate-limit model used by
# map-reduce summarisation + keyphrase extraction. Splitting them keeps
# the bulk-ingest auto-summarise pass from burning chat-quality quotas.
LLM_PROVIDER=openai               # openai | azure | anthropic | bedrock | ollama
LLM_MODEL=gpt-4o
SUMMARISATION_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Azure OpenAI (only if LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=
# Ollama (only if LLM_PROVIDER=ollama) — point at your GPU pod
OLLAMA_BASE_URL=http://localhost:11434
# When LLM_PROVIDER=ollama, set LLM_MODEL to the Ollama tag, e.g.
# qwen2.5:32b, llama3.3:70b-instruct-q4_K_M, deepseek-r1:32b

# -------- Embeddings --------
# pgvector's HNSW index caps at 2000 dimensions. Default is 1536
# (text-embedding-3-small). For text-embedding-3-large, set dim to
# something ≤2000 and pass `dimensions` to OpenAI (Matryoshka).
EMBEDDINGS_PROVIDER=openai        # openai | azure | cohere | huggingface | ollama
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIM=1536
# Ollama presets (only if EMBEDDINGS_PROVIDER=ollama):
#   nomic-embed-text             → EMBEDDINGS_DIM=768
#   bge-m3                       → EMBEDDINGS_DIM=1024
#   mxbai-embed-large            → EMBEDDINGS_DIM=1024
#   snowflake-arctic-embed:large → EMBEDDINGS_DIM=1024
# Changing dim requires Alembic migration 0003 + re-ingest. See docs/OLLAMA.md.

# -------- Reranker --------
# 'bge'    = BAAI/bge-reranker-large (MIT). 100% OSS, runs locally —
#            install with: uv pip install -e 'packages/search[bge-reranker]'
# 'cohere' = managed API, needs COHERE_API_KEY (free tier ~1000/month).
# 'none'   = pass-through (no extra accuracy, no extra deps).
RERANKER_PROVIDER=bge             # bge | cohere | none
COHERE_API_KEY=
BGE_RERANKER_MODEL=BAAI/bge-reranker-large

# -------- Vector store --------
VECTOR_STORE=pgvector             # pgvector | qdrant | azure-ai-search | pinecone
VECTOR_INDEX_TYPE=hnsw            # hnsw | ivfflat
VECTOR_HNSW_M=16
VECTOR_HNSW_EF_CONSTRUCTION=64

# -------- Auth --------
AUTH_PROVIDER=jwt                 # jwt | oidc | entra | auth0
JWT_SECRET=change-me-in-prod-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_AUDIENCE=askai
JWT_ISSUER=faastlab-askai

# -------- Tenancy --------
DEFAULT_TENANT=demo-public        # tenant slug used when none supplied (dev only)

# -------- BYOK (bring your own LLM key) --------
# Set REQUIRE_BYOK=true on public live demos so visitors must supply
# their own OPENAI key as the X-OpenAI-API-Key header — the server's
# OPENAI_API_KEY is never used for /v1/ask or /v1/search calls. The
# chat UI auto-detects this via /v1/config and shows the gear modal.
REQUIRE_BYOK=false

# -------- API --------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT_PER_MIN=60

# -------- Chat UI (Next.js) --------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_TENANT=demo-public

# -------- Observability --------
OBSERVABILITY_PROVIDER=langfuse   # langfuse | langsmith | none
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=

# -------- Indexing --------
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
PDF_PARSER=pymupdf                # pymupdf | unstructured | docling
PARSER_FALLBACK=unstructured

# -------- Celery --------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -------- Watcher (regulator change feed) --------
# Polls FCA/BoE/PRA/FOS/TPR feeds and persists new publications to
# `watcher_events`. The `watcher` docker-compose profile must also be
# enabled: `docker compose --profile app --profile watcher up -d`.
WATCHER_ENABLED=false
WATCHER_TENANT_SLUG=demo-public
WATCHER_POLL_INTERVAL_SECONDS=3600
WATCHER_USER_AGENT=FaastLab-AskAi-Watcher/0.1 (+https://faastlab.ai)
# Generic webhook — leave blank to disable; set to a URL to POST each batch.
WATCHER_WEBHOOK_URL=
# Per-regulator feed URLs (override only if a regulator moves a feed).
WATCHER_FCA_URL=https://www.fca.org.uk/news/rss.xml
WATCHER_BOE_URL=https://www.bankofengland.co.uk/rss/news
WATCHER_PRA_URL=https://www.bankofengland.co.uk/rss/publications
# FOS does not currently publish a stable RSS feed; leave blank to skip.
WATCHER_FOS_URL=
WATCHER_TPR_URL=https://www.gov.uk/government/organisations/the-pensions-regulator.atom
WATCHER_ICO_URL=https://www.gov.uk/government/organisations/information-commissioner-s-office.atom
WATCHER_HMRC_URL=https://www.gov.uk/government/organisations/hm-revenue-customs.atom
# When true, each new event's URL is fetched and ingested into the corpus
# so new publications are searchable within one poll cycle.
WATCHER_AUTO_INGEST=false
