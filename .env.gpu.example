# GPU-host overrides — applied AFTER .env via:
#   docker compose ... --env-file .env --env-file .env.gpu ...
#
# Anything not set here falls back to .env. The point of this file is to
# flip the AI backends from OpenAI to local Ollama (and ensure the
# reranker stays on GPU) WITHOUT touching the shared .env that the CPU
# stack relies on.

# ---- LLM (answer generation + summarisation) -------------------------
# Sovereign: route through the in-pod Ollama service. The adapter is
# already in packages/askai/.../adapters/llm_ollama.py.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:14b
SUMMARISATION_MODEL=qwen2.5:14b
OLLAMA_BASE_URL=http://ollama:11434

# ---- Embeddings ------------------------------------------------------
# Sovereign: bge-m3 via Ollama (1024-dim, multilingual). Note that
# pgvector columns are sized for whatever EMBEDDINGS_DIM was at
# ingestion time — re-ingest the corpus on this host if you want bge-m3
# vectors instead of OpenAI's 1536-dim ones. Otherwise leave the
# embeddings provider on OpenAI so existing vectors still match.
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=bge-m3
EMBEDDINGS_DIM=1024

# ---- Reranker --------------------------------------------------------
# Same bge-reranker-base as CPU, but PyTorch now sees the GPU so it
# runs ~10-25x faster. Bump to v2-m3 for higher quality once you have
# the VRAM headroom (A100 / H100).
RERANKER_PROVIDER=bge
# BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3   # uncomment on A100/H100

# ---- BYOK off -------------------------------------------------------
# This pod doesn't need visitors to bring an OpenAI key (we're not
# calling OpenAI). Force it off so the chat UI doesn't show the gear-
# icon prompt.
REQUIRE_BYOK=false

# ---- Ollama tuning (optional) ----------------------------------------
# OLLAMA_KEEP_ALIVE=24h          # keep model warm; see compose override
# OLLAMA_PORT=11434              # only matters if you want host access

# ---- Torch CUDA build (optional) -------------------------------------
# Default is cu128 — supports Blackwell (RTX 5090, RTX 6000 PRO
# Blackwell, etc.) AND remains back-compatible with Ampere/Ada/Hopper
# (A100, H100, 3090, 4090). Only override if you specifically want the
# smaller cu124 wheel on an older-only host.
# TORCH_CUDA=cu128
# CUDA_BASE=12.6.2
